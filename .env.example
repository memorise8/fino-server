################################
# ENVIRONMENT
################################
ENV=local
DEBUG=true

################################
# API SERVER
################################
API_HOST=0.0.0.0
API_PORT=8000

################################
# LLM (Agent-only usage)
################################
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT=30

################################
# RAG (Step 4 readiness)
################################
RAG_BACKEND=stub
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.45

################################
# VECTOR DB PLACEHOLDERS
################################
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=fino
VECTOR_DB_USER=fino
VECTOR_DB_PASSWORD=fino

################################
# DSL / GUIDE
################################
LAW_SCOPE_DSL_PATH=./data/law_scope_dsl.json
GUIDE_INDEX_PATH=./data/guides/

################################
# MCP / TOOL
################################
MCP_ENABLED=false
MCP_ENDPOINT=http://localhost:9000

################################
# LOGGING
################################
LOG_LEVEL=INFO
