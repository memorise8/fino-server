################################
# ENVIRONMENT
################################
ENV=local              # local | dev | prod
DEBUG=true

################################
# API SERVER
################################
API_HOST=0.0.0.0
API_PORT=8000

################################
# LLM (Agent 내부에서만 사용)
################################
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT=30

################################
# RAG (Step 4 대비, 현재 미사용)
################################
RAG_BACKEND=stub        # stub | chroma | elastic | pgvector
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.25

################################
# VECTOR DB (예: Chroma / PGVector)
################################
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=fino
VECTOR_DB_USER=fino
VECTOR_DB_PASSWORD=fino

################################
# DSL / GUIDE
################################
LAW_SCOPE_DSL_PATH=./data/law_scope_dsl.json
GUIDE_INDEX_PATH=./data/guides/

################################
# MCP / TOOL (Step 4~5)
################################
MCP_ENABLED=false
MCP_ENDPOINT=http://localhost:9000

################################
# LOGGING
################################
LOG_LEVEL=INFO
